# Copy to .env.local (or .env) and fill in. Never commit real values.

# Auth.js / NextAuth: session encryption secret. Generate with: openssl rand -base64 32
AUTH_SECRET=
# Public URL of the app (used for OAuth callbacks). http://localhost:3000 locally.
NEXTAUTH_URL=http://localhost:3000

# Google OAuth client (Google Cloud Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Upstash Redis (console.upstash.com > your database > REST API)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: Vercel Blob read/write token. Enables avatar and attachment uploads.
BLOB_READ_WRITE_TOKEN=
