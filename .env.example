# Salin ke .env.local (atau .env) lalu isi. Jangan pernah commit nilai asli.

# Auth.js (NextAuth): kunci enkripsi sesi. Buat dengan: openssl rand -base64 32
AUTH_SECRET=
# URL publik aplikasi (dipakai untuk callback OAuth). Lokal: http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (Google Cloud Console > APIs & Services > Credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Upstash Redis (console.upstash.com > database > REST API)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Opsional: email yang otomatis menjadi ADMIN saat masuk (pisahkan dengan koma)
ADMIN_EMAILS=

# Opsional: penyimpanan berkas (foto profil, lampiran, bukti).
# Isi token Vercel Blob untuk produksi. Tanpa token, development memakai disk lokal (.data/uploads)
# dan produksi menonaktifkan unggahan.
BLOB_READ_WRITE_TOKEN=
# STORAGE_DRIVER=vercel-blob   # atau "local" (hanya development)

# Hanya untuk test integrasi data layer (gunakan database Redis sekali pakai, BUKAN produksi)
# TEST_UPSTASH_REDIS_REST_URL=
# TEST_UPSTASH_REDIS_REST_TOKEN=

# Hanya untuk scripts/migrate-prisma-to-redis.ts (database PostgreSQL lama, dibaca saja)
# SOURCE_DATABASE_URL=
